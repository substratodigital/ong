# Variáveis de Ambiente — Fundação Net do Bem (V5)
# Configure estas variáveis no painel da Vercel (Settings -> Environment Variables)

# 1. Resend (Envio do formulário de contato)
RESEND_API_KEY=re_sua_chave_resend_aqui
CONTACT_TO_EMAIL=site@netdobem.org.br
RESEND_FROM_EMAIL="Fundação Net do Bem <site@netdobem.org.br>"

# 2. Cloudflare Turnstile (reCAPTCHA anti-bots)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

